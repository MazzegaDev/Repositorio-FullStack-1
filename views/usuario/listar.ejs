<h1>Usuarios cadastrados</h1>

<div>
    <a href="/usuario/cadastrar" class="btn btn-primary">Novo usuario</a>

    <div>
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nome</th>
                    <th>Email</th>
                    <th>Ativo</th>
                    <th>Perfil</th>
                </tr>
            </thead>
            <tbody>
                <% for (let i = 0; i < usuarios.length; i++) {%>
                    
                    <tr>
                            
                        /*usuarios[i] -> */   
                        <td><%=usuarios[i].usuarioID %></td>
                        <td><%=usuarios[i].usuarioNome %></td>
                        <td><%=usuarios[i].usuarioEmail %></td>
                        <td><%=usuarios[i].usuarioAtivo %></td>
                        <td><%=usuarios[i].usuarioPerfilId %></td>
                    </tr>
                    
                <%} %>
            </tbody>

        </table>
    </div>
</div>