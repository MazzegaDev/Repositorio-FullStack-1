<script src="/js/usuario/deletar.js"></script>
<h1>Usuarios cadastrados</h1>

<div>
    <a href="/usuario/cadastrar" class="btn btn-primary">Novo usuario</a>

    <div>
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nome</th>
                    <th>Email</th>
                    <th>Ativo</th>
                    <th>Perfil</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                <% for (let i = 0; i < usuarios.length; i++) {%>
                    
                    <tr>
                        <td><%=usuarios[i].usuarioID %></td>
                        <td><%=usuarios[i].usuarioNome %></td>
                        <td><%=usuarios[i].usuarioEmail %></td>
                        <td><%=usuarios[i].usuarioAtivo %></td>
                        <td><%=usuarios[i].perfilDesc %></td>
                        <td>
                            <!--Data atribute para representar o id do usuario o botao de lapis ja passa o id do clicado para a rota -->
                            <button data-id="<%=usuarios[i].usuarioID%>" class="btn btn-danger btn-excluir"><i class="fas fa-trash"></i></button>
                            <a href="/usuario/atualizar/<%=usuarios[i].usuarioID%>" class="btn btn-primary"><i class="fas fa-pen"></i></a>
                        </td>
                    </tr>
                    
                <%} %>
            </tbody>

        </table>    
    </div>
</div>