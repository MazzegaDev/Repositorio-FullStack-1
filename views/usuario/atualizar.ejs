<script src="/js/usuario/atualizar.js"></script>

<div>
    <div class="form-group">
        <!--Label ajuda leitores de tela a deixar o formulario acessivel-->
        <input type="hidden"  class="form-control" id="txtId" value="<%= usuario.usuarioID  %>">
    </div>

    <div class="form-group">
        <!--Label ajuda leitores de tela a deixar o formulario acessivel-->
        <label for="txtNome">Nome:</label>
        <input type="text"  class="form-control" id="txtNome" value="<%= usuario.usuarioNome  %>">
    </div>
    <div class="form-group">
        <label for="txtEmail">Email</label>
        <input type="email" class="form-control" id="txtEmail" value="<%= usuario.usuarioEmail  %>">
    </div>
    <div class="form-group">
        <label for="txtSenha">Senha</label>
        <input type="password" class="form-control" id="txtSenha" value="<%= usuario.usuarioSenha  %>">
    </div>
    <div class="form-group">
        <label for="selPerfil">Perfil</label>
        <select class="form-control" id="selPerfil">
            <option value="0"> --Selecione-- </option>

            <% if (lista.length < 0) {%>
                <span>Nenhum perfil cadastrado</span>
            <%}else{%>
                <%for(let i=0; i<lista.length; i++){%>
                    <% if(usuario.perfilId == lista[i].perfilId){%> <!--Verifica se o per_id do usuario encotrado é igual de algum perfil na lista-->
                         <option selected="true" value="<%=lista[i].perfilId%>"><%= lista[i].perfilDescricao %></option>
                    <%}else{%>
                         <option  value="<%=lista[i].perfilId%>"><%= lista[i].perfilDescricao %></option>
                    <%}%>
                   
                <%}%>
            <%} %>

            
        </select>
    </div>
    <div class="form-group">
        <label for="cbAtivo">
            <% if(usuario.usuarioAtivo == 1){ %>
                 <input  type="checkbox" id="cbAtivo" checked="true"/>Ativo
            <%}else{%>
                 <input  type="checkbox" id="cbAtivo" checked="false"/>Ativo
            <%} %>
           
        </label>
    </div>
    <div>
        <button class="btn btn-primary" id="gravar">Alterar</button>
        
                <span>
                    <a href="/usuario" class="btn btn-default">Voltar</a>
                </span>
        
       
           
        
    </div>
</div>